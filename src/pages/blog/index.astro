---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 전체 태그 수집 (빈도 내림차순 → 이름순)
const tagCounts = new Map<string, number>();
for (const post of sortedPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const allTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag]) => tag);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .format(date).replace(/\. /g, '.').replace(/\.$/, '');
}
---

<BaseLayout title="Writing" description="기술, 분산시스템, AI 그리고 엔지니어링에 대한 글">
  <section class="max-w-5xl mx-auto px-6 pt-16 pb-32">
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-white mb-3 tracking-tight">Writing</h1>
      <p class="text-sm text-[#52525b]">기술, 분산시스템, AI, 그리고 엔지니어링</p>
    </div>

    <!-- 검색 + 태그 필터 -->
    <div class="mb-10 space-y-5">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#3f3f46] pointer-events-none"
             fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <line x1="21" y1="21" x2="16.5" y2="16.5" />
        </svg>
        <input
          id="post-search"
          type="search"
          autocomplete="off"
          placeholder="제목, 설명, 태그로 검색…"
          aria-label="글 검색"
          class="w-full bg-[#0f0f0f] border border-[#1f1f1f] rounded-md pl-10 pr-3 py-2.5 text-sm text-[#e4e4e7] placeholder:text-[#3f3f46] focus:outline-none focus:border-teal-500/60 transition-colors"
        />
      </div>

      <div id="tag-filters" class="flex flex-wrap gap-1.5" role="group" aria-label="태그 필터">
        <button
          type="button"
          data-tag="__all__"
          class="tag-chip is-active text-[11px] px-2.5 py-1 rounded border border-[#1f1f1f] text-[#71717a] transition-colors"
        >전체</button>
        {allTags.map((tag) => (
          <button
            type="button"
            data-tag={tag}
            class="tag-chip text-[11px] px-2.5 py-1 rounded border border-[#1f1f1f] text-[#52525b] transition-colors"
          >{tag}<span class="ml-1 text-[#3f3f46]">{tagCounts.get(tag)}</span></button>
        ))}
      </div>
    </div>

    <div id="post-list">
      {sortedPosts.map((post) => (
        <a href={`/blog/${post.slug}`}
           class="post-item group flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 py-5 border-b border-[#141414] hover:border-[#242424] transition-colors"
           data-title={post.data.title.toLowerCase()}
           data-desc={(post.data.description ?? '').toLowerCase()}
           data-tags={post.data.tags.join(' ').toLowerCase()}>
          <time class="text-[11px] text-[#3f3f46] tabular-nums shrink-0 sm:w-28 font-mono">
            {formatDate(post.data.date)}
          </time>
          <div class="flex-1 min-w-0">
            <span class="block text-sm text-[#a1a1aa] group-hover:text-white transition-colors font-medium">
              {post.data.title}
            </span>
            {post.data.description && (
              <span class="block text-xs text-[#3f3f46] mt-1">{post.data.description}</span>
            )}
          </div>
          <div class="flex gap-1.5 shrink-0">
            {post.data.tags.map((tag: string) => (
              <span class="text-[10px] text-[#3f3f46] border border-[#1f1f1f] px-2 py-0.5">{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>

    <p id="no-results" class="hidden py-16 text-center text-sm text-[#52525b]">
      조건에 맞는 글이 없어요.
    </p>
  </section>

  <style>
    .tag-chip:hover { color: #a1a1aa; border-color: #2a2a2a; }
    .tag-chip.is-active {
      color: #2dd4bf; /* teal-400 */
      border-color: rgba(20, 184, 166, 0.5);
      background-color: rgba(20, 184, 166, 0.08);
    }
  </style>

  <script>
    const ALL = '__all__';
    const search = document.getElementById('post-search') as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-chip'));
    const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('.post-item'));
    const noResults = document.getElementById('no-results');

    let activeTag = ALL;

    function apply() {
      const q = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;

      for (const item of items) {
        const title = item.dataset.title ?? '';
        const desc = item.dataset.desc ?? '';
        const tags = item.dataset.tags ?? '';

        const matchesText = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
        const matchesTag = activeTag === ALL || tags.split(' ').includes(activeTag);
        const show = matchesText && matchesTag;

        item.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      noResults?.classList.toggle('hidden', visible > 0);
    }

    search?.addEventListener('input', apply);

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        activeTag = chip.dataset.tag ?? ALL;
        for (const c of chips) c.classList.toggle('is-active', c === chip);
        apply();
      });
    }
  </script>
</BaseLayout>
