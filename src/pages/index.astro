---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' })
    .format(date).replace(/\. /g, '.').replace(/\.$/, '');
}
---

<BaseLayout title="Elon's Notes" description="생각, 기술, 그리고 사이에 있는 것들">

  <section class="max-w-3xl mx-auto px-6 pt-20 pb-32">

    <!-- 블로그 타이틀 -->
    <div class="mb-16">
      <h1 class="text-2xl font-bold text-white mb-2 tracking-tight">Elon's Notes</h1>
      <p class="text-sm text-[#52525b]">생각, 기술, 그리고 사이에 있는 것들</p>
    </div>

    <!-- 글 목록 -->
    <div>
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-8 py-4 border-b border-[#141414] hover:border-[#2a2a2a] transition-colors"
        >
          <time class="text-[11px] text-[#3f3f46] tabular-nums shrink-0 sm:w-28 font-mono">
            {formatDate(post.data.date)}
          </time>
          <div class="flex-1 flex flex-wrap items-baseline gap-3 min-w-0">
            <span class="text-sm text-[#a1a1aa] group-hover:text-white transition-colors">
              {post.data.title}
            </span>
            <div class="flex gap-1.5 shrink-0">
              {post.data.tags.map((tag: string) => (
                <span class="text-[10px] text-[#3f3f46]">#{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

  </section>

</BaseLayout>
